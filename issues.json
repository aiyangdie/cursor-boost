[
  {
    "id": "too_many_trials",
    "title": "试用账号过多 (Too many free trials)",
    "category": "账号",
    "patterns": ["Too many free trial", "too many free trials"],
    "severity": "high",
    "fix_mode": "manual",
    "desc": "本机注册的免费试用账号超过 Cursor 服务器限制，Agent 无法使用。",
    "fix_action": "TrialLimitHelp",
    "fix_label": "查看解决办法",
    "manual_only": true,
    "note": "服务器端限制，清缓存无法绕过。需 Pro、已有 Pro 账号，或联系官方附 Request ID。"
  },
  {
    "id": "usage_limit",
    "title": "Agent 用量用尽 (usage limit)",
    "category": "账号",
    "patterns": ["You've hit your usage limit", "error_code\":\"upgrade\"", "Get Cursor Pro for more Agent"],
    "severity": "high",
    "fix_mode": "manual",
    "desc": "当前账号本月 Agent 请求额度用完（与试用机限制不同）。",
    "fix_action": "UsageLimitHelp",
    "fix_label": "查看解决办法",
    "manual_only": true,
    "note": "等额度重置、升级 Pro，或换有额度的账号 Sign in。"
  },
  {
    "id": "signin_switch",
    "title": "换号 / 登录状态异常",
    "category": "账号",
    "patterns": ["unauthenticated", "ERROR_UNAUTHORIZED"],
    "severity": "medium",
    "fix_mode": "restart",
    "desc": "Token 过期、换号后状态不一致。",
    "fix_action": "ClearAuthCache",
    "fix_label": "清登录缓存换号"
  },
  {
    "id": "auth_econnreset",
    "title": "云端认证失败 (ECONNRESET / HTTP2)",
    "category": "网络",
    "patterns": ["ECONNRESET", "ERR_HTTP2", "TLS connection was established", "Failed to refresh authentication"],
    "severity": "medium",
    "fix_mode": "hot",
    "desc": "连接 Cursor 云端时网络中断，国内 HTTP/2 不稳定常见。",
    "fix_action": "FixSettings",
    "fix_label": "热修复网络"
  },
  {
    "id": "agent_network_drop",
    "title": "Agent 流式连接中断",
    "category": "网络",
    "patterns": ["Stream ended without turnEnded", "connection likely dropped mid-stream"],
    "severity": "medium",
    "fix_mode": "hot",
    "desc": "Agent 回复到一半断线，常伴随网络抖动或扩展宿主卡顿。",
    "fix_action": "SmartFix",
    "fix_label": "智能热修复"
  },
  {
    "id": "ssh_port_timeout",
    "title": "SSH 连接超时 (端口错误)",
    "category": "SSH",
    "patterns": ["Connection timed out", "port 33265", "Failed to connect to the remote SSH host", "connect ETIMEDOUT"],
    "severity": "high",
    "fix_mode": "hot",
    "desc": "SSH 端口配置错误或安全组未开放。",
    "fix_action": "FixSsh",
    "fix_label": "修复 SSH 配置"
  },
  {
    "id": "ssh_server_install_path",
    "title": "SSH 设置错误 (serverInstallPath)",
    "category": "SSH",
    "patterns": ["Invalid setting 'remote.SSH.serverInstallPath'", "must be a object"],
    "severity": "high",
    "fix_mode": "hot",
    "desc": "settings.json 里 serverInstallPath 写成了字符串。",
    "fix_action": "FixSettings",
    "fix_label": "热修复 settings"
  },
  {
    "id": "root_workspace",
    "title": "打开了 /root 工作区",
